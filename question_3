set.seed(123)
lambda <- 5
n_values <- c(10, 50, 200)
B_sim <- 1000


sims <- list()


for (n in n_values) {
  
  # empty vectors to store results
  xbar_vec <- rep(0, B_sim)       # sample means
  ci_lower_vec <- rep(0, B_sim)   # lower CI endpoints
  ci_upper_vec <- rep(0, B_sim)   # upper CI endpoints
  

  for (b in 1:B_sim) {
    x <- rpois(n, lambda)
    xbar <- mean(x)
    se <- sqrt(xbar) / sqrt(n)
    
    # 95% CI
    ci_lower <- xbar - 2 * se
    ci_upper <- xbar + 2 * se
    
    xbar_vec[b] <- xbar
    ci_lower_vec[b] <- ci_lower
    ci_upper_vec[b] <- ci_upper
  }
  
  sims[[paste0("n", n)]] <- data.frame(
    xbar = xbar_vec,
    ci_lower = ci_lower_vec,
    ci_upper = ci_upper_vec
  )
}

# part a
par(mfrow = c(1, 3))  # Set up 1 row, 3 columns for plots
for (n in n_values) {
  hist(sims[[paste0("n", n)]]$xbar, 
       main = paste("Sample Mean, n =", n),
       xlab = "Sample Mean", 
       col = "lightblue", 
       breaks = 30)
  abline(v = lambda, col = "red")  # True mean line
}

#part b
par(mfrow = c(2, 3))  # Set up 2 rows, 3 columns
# First row: lower endpoints
for (n in n_values) {
  hist(sims[[paste0("n", n)]]$ci_lower, 
       main = paste("Lower CI, n =", n),
       xlab = "Lower Endpoint", 
       col = "lightcoral", 
       breaks = 30)
  abline(v = lambda, col = "red")
}
# Second row: upper endpoints 
for (n in n_values) {
  hist(sims[[paste0("n", n)]]$ci_upper, 
       main = paste("Upper CI, n =", n),
       xlab = "Upper Endpoint", 
       col = "lightgreen", 
       breaks = 30)
  abline(v = lambda, col = "red")
}

# part c
for (n in n_values) {
  data <- sims[[paste0("n", n)]]
  coverage <- mean(data$ci_lower <= lambda & data$ci_upper >= lambda)
  cat(sprintf("n = %3d: %.2f%%\n", n, coverage * 100))
}


# part d
B_sim_boot <- 100
B_boot <- 100

boot_sims <- list()

for (n in n_values) {
  cat("Bootstrap for n =", n, "\n")
  
  # Storage for bootstrap results
  boot_lower_vec <- rep(0, B_sim_boot)
  boot_upper_vec <- rep(0, B_sim_boot)
  
  # Run B_sim_boot = 100 simulations
  for (b in 1:B_sim_boot) {

    x <- rpois(n, lambda)
    
    #Bootstrap- resample from x many times
    boot_means <- rep(0, B_boot)
    for (boot_iter in 1:B_boot) {
      # Resample WITH REPLACEMENT from x
      boot_sample <- sample(x, size = n, replace = TRUE)
      boot_means[boot_iter] <- mean(boot_sample)
    }
    
    boot_lower_vec[b] <- quantile(boot_means, 0.025)
    boot_upper_vec[b] <- quantile(boot_means, 0.975)
  }
  
  boot_sims[[paste0("n", n)]] <- data.frame(
    lower = boot_lower_vec,
    upper = boot_upper_vec
  )
}


# Bootstrap histograms (6 histograms)

par(mfrow = c(2, 3))
for (n in n_values) {
  hist(boot_sims[[paste0("n", n)]]$lower, 
       main = paste("Bootstrap Lower CI, n =", n),
       xlab = "Lower Endpoint", 
       col = "lightcoral", 
       breaks = 20)
  abline(v = lambda, col = "blue")
}
for (n in n_values) {
  hist(boot_sims[[paste0("n", n)]]$upper, 
       main = paste("Bootstrap Upper CI, n =", n),
       xlab = "Upper Endpoint", 
       col = "lightgreen", 
       breaks = 20)
  abline(v = lambda, col = "blue")
}


for (n in n_values) {
  data <- boot_sims[[paste0("n", n)]]
  coverage <- mean(data$lower <= lambda & data$upper >= lambda)
  cat(sprintf("n = %3d: %.2f%%\n", n, coverage * 100))
}
